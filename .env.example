# バックエンド環境変数
# データベースのURL
DATABASE_URL="sqlite:///./test.db"

# シークレットキー
# 本番では `openssl rand -hex 32` などで十分に長い値を生成する
SECRET_KEY=replace-with-at-least-32-random-bytes

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_DAYS=60

# ローカルではfalse。本番HTTPSではtrueにする
COOKIE_SECURE=false
# VercelとRailwayが別サイトならnone、同一サイトならlax
COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=refresh_token

# allow_origins
ALLOW_ORIGINS=http://localhost:5173

# フロントエンド環境変数
# API URL
VITE_API_URL=http://localhost:8000
